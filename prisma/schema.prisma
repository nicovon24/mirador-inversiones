generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Market {
  AR
  US
}

enum AssetType {
  STOCK
  CEDEAR
  BOND
  ETF
  CRYPTO
  FX
  OTHER
}

enum AlertCondition {
  ABOVE
  BELOW
  PCT_CHANGE
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
}

model Instrument {
  id        String    @id @default(cuid())
  symbol    String
  market    Market
  name      String?
  type      AssetType @default(STOCK)
  currency  String    @default("ARS")
  createdAt DateTime  @default(now())

  watchlistItems WatchlistItem[]
  positions      Position[]
  alerts         Alert[]

  @@unique([symbol, market])
}

model Watchlist {
  id        String          @id @default(cuid())
  name      String
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  items     WatchlistItem[]
}

model WatchlistItem {
  id           String     @id @default(cuid())
  watchlistId  String
  instrumentId String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  watchlist    Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, instrumentId])
}

/// Posiciones cargadas a mano (las de IOL se leen en vivo desde la API).
model Position {
  id           String     @id @default(cuid())
  instrumentId String
  quantity     Decimal    @db.Decimal(20, 8)
  avgPrice     Decimal    @db.Decimal(20, 8)
  currency     String     @default("ARS")
  openedAt     DateTime   @default(now())
  note         String?
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
}

model Alert {
  id            String         @id @default(cuid())
  instrumentId  String
  condition     AlertCondition
  /// Precio objetivo (ABOVE/BELOW) o porcentaje (PCT_CHANGE).
  target        Decimal        @db.Decimal(20, 8)
  /// Precio de referencia al crear la alerta, para PCT_CHANGE.
  basePrice     Decimal?       @db.Decimal(20, 8)
  status        AlertStatus    @default(ACTIVE)
  repeat        Boolean        @default(false)
  note          String?
  triggeredAt   DateTime?
  createdAt     DateTime       @default(now())
  instrument    Instrument     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  alertId   String?
  title     String
  body      String
  price     Decimal? @db.Decimal(20, 8)
  read      Boolean  @default(false)
  sentTo    String?
  createdAt DateTime @default(now())
  alert     Alert?   @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([read, createdAt])
}

/// Usuario de la app. Se crea con `npm run user:create`; no hay registro público.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// scrypt: "scrypt$N$r$p$salt$hash" (base64url).
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  sessions              Session[]
  iolConnection         IolConnection?
  pendingAuthorizations PendingAuthorization[]
}

/// Sesión de login. El id es SHA-256 del token de la cookie: un volcado de la base no permite reusar sesiones.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Cliente OAuth registrado dinámicamente en IOL (POST /register), uno por URL de callback.
model OAuthClient {
  id          String   @id @default(cuid())
  callbackUri String   @unique
  clientId    String
  createdAt   DateTime @default(now())
}

/// Autorización OAuth en curso: vive 10 minutos y se consume una sola vez en el callback.
model PendingAuthorization {
  id                String   @id @default(cuid())
  /// SHA-256 (hex) del state: el state en claro solo viaja en la URL y en la cookie del flujo.
  stateHash         String   @unique
  userId            String
  clientId          String
  /// code_verifier PKCE cifrado con AES-256-GCM.
  encryptedVerifier String
  returnTo          String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Conexión de un usuario con su cuenta de IOL. Los tokens están cifrados y nunca salen del servidor.
model IolConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  clientId              String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  authorizedAt          DateTime
  /// authorizedAt + 30 días: el refresh no lo extiende.
  absoluteExpiresAt     DateTime
  /// Lock de renovación entre instancias: quien lo toma renueva, el resto espera el token nuevo.
  refreshLockUntil      DateTime?
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Caché persistente de datos fundamentales por ticker del proveedor (AAPL, YPF, GGAL…).
/// Un CEDEAR y su acción en EE.UU., o una acción argentina y su ADR, comparten fila.
model Fundamentals {
  symbol    String   @id
  /// Métricas numéricas tal como las entrega el proveedor (peTTM, roeTTM…).
  metrics   Json
  /// Perfil de la empresa: nombre, rubro, bolsa, logo…
  profile   Json?
  source    String   @default("finnhub")
  /// "ok" | "empty" (el proveedor no tiene datos) | "error" (falló la descarga).
  status    String   @default("ok")
  error     String?
  fetchedAt DateTime

  @@index([fetchedAt])
}

/// Fila única (id = "singleton") con preferencias del usuario.
model Setting {
  id             String  @id @default("singleton")
  theme          String  @default("system")
  baseCurrency   String  @default("ARS")
  telegramChatId String?
}
