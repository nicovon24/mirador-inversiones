# Postgres (local: docker compose up -d · producción: Neon desde Vercel Marketplace)
DATABASE_URL="postgresql://mirador:mirador@localhost:5440/mirador"

# InvertirOnline (opcional). Sin esto, Argentina usa data912 (gratis, puede tener demora).
IOL_USERNAME=""
IOL_PASSWORD=""

# Finnhub (opcional, https://finnhub.io). Sin esto, USA usa data912/Yahoo.
FINNHUB_API_KEY=""

# Telegram (alertas con la app cerrada). Bot creado con @BotFather.
TELEGRAM_BOT_TOKEN=""
# Cadena aleatoria para validar el webhook de Telegram.
TELEGRAM_WEBHOOK_SECRET=""

# Protege /api/cron/alerts. Enviar como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Conexión con tu cuenta de IOL por OAuth (MCP de solo lectura). La app nunca ve tu contraseña de IOL.
# Clave propia para cifrar los tokens (mínimo 32 caracteres). Generala con: openssl rand -hex 32
IOL_SESSION_SECRET=""
IOL_MCP_BASE_URL="https://mcp.invertironline.com"
# URL fija a la que IOL vuelve después del login. En producción, la URL pública de la app.
IOL_MCP_CALLBACK_URI="http://localhost:3000/api/iol/callback"
